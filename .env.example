# ─────────────────────────────────────────────────────────────────────────────
# BlockFinaX Smart Contract Deployment — Environment Variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployer wallet ───────────────────────────────────────────────────────────
# Private key of the wallet that pays gas and owns the Diamond on first deploy.
# Rotate ownership to a cold wallet immediately after deployment using:
#   transferOwnership(newAddr)  →  newAddr calls acceptOwnership()
# Then discard this key from all .env files.
DEPLOYER_PRIVATE_KEY=

# ── Oracle wallets (addresses only — no private keys here) ───────────────────
# Three independent oracle node wallet addresses for multi-signer consensus.
# These wallets call submitRate() from separate server processes.
# Private keys for these wallets live only on the oracle node servers.
ORACLE_A=
ORACLE_B=
ORACLE_C=


# ── USDC address overrides ────────────────────────────────────────────────────
# Required for Lisk Mainnet (chainId 1135) — verify at https://blockscout.lisk.com/tokens
# Search for "USDC" to find the official bridged USDC contract address before deploying.
USDC_LISK_MAINNET=

# ── Contract verification ──────────────────────────────────────────────────────
# Basescan API key (only needed for Base networks).
# Lisk networks use Blockscout which does not require an API key.
BASESCAN_API_KEY=

# ── Frontend environment (set in client/.env, not here) ───────────────────────
# VITE_NETWORK_MODE=mainnet        # "testnet" (default) or "mainnet"
# VITE_DIAMOND_ADDRESS=0x...       # Diamond address after deployment
