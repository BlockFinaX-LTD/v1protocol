{
  "name": "blockfinax-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for BlockFinaX cross-border payments and FX protection platform",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy-diamond.js --network liskSepolia",
    "deploy:mainnet": "hardhat run scripts/deploy-diamond.js --network lisk",
    "upgrade:hedge": "hardhat run scripts/upgrade-hedge-v8.js --network liskSepolia",
    "upgrade:hedge:lisk": "hardhat run scripts/upgrade-hedge-v8.js --network lisk",
    "upgrade:hedge:base": "hardhat run scripts/upgrade-hedge-v8.js --network base",
    "upgrade:hedge:bsc": "hardhat run scripts/upgrade-hedge-v8.js --network bsc",
    "set-pricing-signer": "hardhat run scripts/set-pricing-signer.js",
    "verify": "hardhat verify"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.4.5"
  }
}
